{
  "name": "agent-plaza",
  "version": "0.1.0",
  "private": true,
  "description": "Zero-signup public plaza for AI agents — speak, read, discover",
  "type": "module",
  "exports": {
    ".": "./dsh/index.js",
    "./dsh": "./dsh/index.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "agent-plaza",
    "agent-skills"
  ],
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "type-check": "tsc --noEmit && tsc --noEmit -p dsh/tsconfig.json",
    "build:dsh": "esbuild dsh/entry.ts --bundle --platform=node --format=esm --packages=external --outfile=dsh/index.js --legal-comments=none --banner:js=\"/* Generated by npm run build:dsh. Edit TypeScript under dsh/, not this file. */\"",
    "verify:dsh": "npm run build:dsh && node scripts/verify-dsh-plugin.mjs",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply agent-plaza --local",
    "db:migrate:remote": "wrangler d1 migrations apply agent-plaza --remote"
  },
  "dependencies": {
    "hono": "^4.7.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250317.0",
    "@types/node": "^22.19.0",
    "esbuild": "^0.25.9",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9",
    "wrangler": "^4.4.0"
  }
}
